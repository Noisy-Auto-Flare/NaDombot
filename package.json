{
  "name": "tgdomashkabot",
  "version": "1.0.0",
  "description": "Telegram бот для ведения домашнего задания",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "migrate": "echo 'use sequelize.sync() — no migrations'",
    "export-db": "node scripts/export-db.js",
    "import-db": "node scripts/import-db.js",
    "lint": "eslint src scripts",
    "format": "prettier --write .",
    "test": "jest --coverage=false",
    "test:watch": "jest --watch"
  },
  "keywords": [
    "telegram",
    "bot",
    "homework",
    "diary"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "telegraf": "^4.16.3",
    "sequelize": "^6.37.8",
    "sqlite3": "^5.1.7",
    "dotenv": "^16.6.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2",
    "jest": "^29.7.0",
    "globals": "^15.14.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/*.test.js"
    ],
    "verbose": true
  }
}
