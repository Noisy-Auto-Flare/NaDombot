# Telegram Bot Token (получить у @BotFather)
BOT_TOKEN=your_bot_token_here

# ID администратора (можно узнать у @userinfobot)
ADMIN_ID=your_admin_telegram_id

# Node environment
NODE_ENV=production

# SQLite — используется по умолчанию (USE_SQLITE=true, SQLITE_PATH=/app/data/db.sqlite заданы в docker-compose.yml)
# Раскомментируйте, только если нужно переопределить путь внутри контейнера
# SQLITE_PATH=/app/data/db.sqlite

# Мультипрофильность (P1): дефолт ВЫКЛ; аварийный оверрайд поверх БД (пусто | 0 | 1)
# MULTIPROFILE_ENABLED=0
# MULTIPROFILE_FORCE=

# Каталог аудиторий: боевой файл config/audience.json (в .gitignore) смонтирован :ro;
# в репо лежит только config/audience.example.json
# AUDIENCE_CONFIG_PATH=./config/audience.json

# Postgres удалён, данные мигрируют через scripts/export-db.js / scripts/import-db.js
# Старые переменные DB_HOST/DB_PORT/DB_NAME/DB_USER/DB_PASSWORD больше не используются
