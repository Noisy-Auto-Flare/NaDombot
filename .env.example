# Telegram Bot Token (получить у @BotFather)
BOT_TOKEN=your_bot_token_here

# ID администратора (можно узнать у @userinfobot)
ADMIN_ID=your_admin_telegram_id

# База данных
DB_HOST=postgres
DB_PORT=5432
DB_NAME=homework_db
DB_USER=postgres
DB_PASSWORD=postgres

# Node environment
NODE_ENV=production

# SQLite (только для docker-compose.sqlite.yml; в нём USE_SQLITE уже задан)
# USE_SQLITE=true
# SQLITE_PATH=/app/data/db.sqlite
